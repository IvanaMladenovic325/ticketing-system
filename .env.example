# Kopirati u .env i popuniti vrednosti:

# user-service baza (docker-compose servis user-db, host port 5433)
USER_DB_USERNAME=
USER_DB_PASSWORD=

# event-service baza (docker-compose servis event-db, host port 5434)
EVENT_DB_USERNAME=
EVENT_DB_PASSWORD=

# booking-service baza (docker-compose servis booking-db, host port 5435)
BOOKING_DB_USERNAME=
BOOKING_DB_PASSWORD=

# payment-service baza (docker-compose servis payment-db, host port 5436)
PAYMENT_DB_USERNAME=
PAYMENT_DB_PASSWORD=

# notification-service baza (docker-compose servis notification-db, host port 5437)
NOTIFICATION_DB_USERNAME=
NOTIFICATION_DB_PASSWORD=

# RabbitMQ (docker-compose servis rabbitmq, AMQP port 5672, management UI 15672)
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

IMAGE_TAG=latest

# SMTP server za mejlove
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=
MAIL_SMTP_STARTTLS=
