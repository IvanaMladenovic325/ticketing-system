# Kopirati u .env i popuniti vrednosti:

# user-service baza (docker-compose servis user-db, host port 5433)
USER_DB_USERNAME=
USER_DB_PASSWORD=

# event-service baza (docker-compose servis event-db, host port 5434)
EVENT_DB_USERNAME=
EVENT_DB_PASSWORD=

# booking-service baza (docker-compose servis booking-db, host port 5435)
BOOKING_DB_USERNAME=
BOOKING_DB_PASSWORD=

# payment-service baza (docker-compose servis payment-db, host port 5436)
PAYMENT_DB_USERNAME=
PAYMENT_DB_PASSWORD=
